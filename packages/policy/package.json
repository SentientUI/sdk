{
  "name": "@sentientui/policy",
  "version": "0.4.0",
  "private": false,
  "description": "Pure decision-policy functions shared by the SentientUI API and the keyless local engine",
  "license": "MIT",
  "homepage": "https://sentient-ui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SentientUI/sdk.git",
    "directory": "packages/policy"
  },
  "bugs": "https://github.com/SentientUI/sdk/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
