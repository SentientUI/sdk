{% comment %}
  SentientUI snippet — the entire storefront integration (spec §3).
  Mirrors the canonical install from the dashboard's Shopify recipe
  (apps/dashboard/app/lib/nocode-install.ts): the window.sentient config
  block followed by the published snippet loader.

  Subresource Integrity is deliberately NOT used on this tag, matching every
  other SentientUI install surface — the snippet is first-party and
  self-updating, so a pinned hash would break every snippet release. If a
  reviewer wants SRI, that's a product-wide decision for the snippet
  pipeline, not this embed.
{% endcomment %}
{% if block.settings.publishable_key != blank %}
<script>
  window.sentient = { apiKey: {{ block.settings.publishable_key | json }} };
</script>
{%- if customer and app.metafields['config']['persona_tags'].value -%}
<script>
  // Customer-tag → persona (B4.4): the mapping lives in an app-owned shop
  // metafield written by the app's settings screen; it declares the persona
  // through the snippet's standard `persona` config. Unrecognized keys are
  // ignored server-side and surface in the dashboard's Personas nudge, so a
  // typo self-diagnoses. Logged-out visitors have no tags → no declaration.
  (function () {
    var tags = {{ customer.tags | json }};
    var map = {{ app.metafields['config']['persona_tags'].value | json }};
    if (!tags || !map) return;
    for (var i = 0; i < tags.length; i++) {
      if (map[tags[i]]) { window.sentient.persona = map[tags[i]]; return; }
    }
  })();
</script>
{%- endif -%}
<script src="https://unpkg.com/@sentientui/snippet/dist/snippet.global.js" crossorigin="anonymous" defer></script>
{% endif %}

{% schema %}
{
  "name": "SentientUI",
  "target": "head",
  "settings": [
    {
      "type": "text",
      "id": "publishable_key",
      "label": "SentientUI publishable key",
      "info": "Your project's pk_… key from the SentientUI dashboard (Settings → API keys)."
    }
  ]
}
{% endschema %}
